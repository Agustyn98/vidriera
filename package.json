{
  "name": "vidriera",
  "version": "1.0.0",
  "description": "Vidriera: landing pages y directorio de comercios del Gran Mendoza (TP3 Comercialización de Servicios)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "demo": "DEMO_DOMINIOS=1 node src/server.js",
    "chrome-demo": "open -na 'Google Chrome' --args --user-data-dir=/tmp/vidriera-chrome-demo --no-first-run --no-default-browser-check --host-resolver-rules=\"MAP *.com.ar 127.0.0.1:${PORT:-3000}\" http://vidriera.com.ar"
  },
  "author": "Agustín Adaro, Jorge Tohme, Ezequiel Castro Burgos",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.4.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
