<%- include('partials/header') %>

<article class="formulario-angosto">
  <h1>Crear cuenta de comerciante</h1>
  <p>Con tu cuenta podés administrar tu página, contratar servicios y ver tus comprobantes.</p>
  <%- include('partials/errores', { errores }) %>
  <form method="post" action="/registro" novalidate>
    <label for="nombre">Nombre y apellido</label>
    <input type="text" id="nombre" name="nombre" value="<%= valores.nombre || '' %>" autocomplete="name" required minlength="2" maxlength="60" <%- h.invalido(errores, 'nombre') %>>
    <%- h.errorCampo(errores, 'nombre') %>

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= valores.email || '' %>" autocomplete="email" required <%- h.invalido(errores, 'email') %>>
    <%- h.errorCampo(errores, 'email') %>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" autocomplete="new-password" required minlength="8" <%- h.invalido(errores, 'password', 'ayuda-password') %>>
    <small id="ayuda-password">Mínimo 8 caracteres, con letras y números.</small>
    <%- h.errorCampo(errores, 'password') %>

    <label for="confirmacion">Repetí la contraseña</label>
    <input type="password" id="confirmacion" name="confirmacion" autocomplete="new-password" required <%- h.invalido(errores, 'confirmacion') %>>
    <%- h.errorCampo(errores, 'confirmacion') %>

    <label for="codigo">Código de tu vista previa <span class="opcional">(opcional)</span></label>
    <input type="text" id="codigo" name="codigo" value="<%= valores.codigo || '' %>" autocomplete="off" maxlength="9" class="campo-codigo" aria-describedby="ayuda-codigo">
    <small id="ayuda-codigo">Si te enviamos un link de vista previa, ingresá su código (por ejemplo DEMO-2026) y el comercio queda a tu nombre.</small>

    <button type="submit">Crear cuenta</button>
  </form>
  <p>¿Ya tenés cuenta? <a href="/login">Ingresá</a>.</p>
</article>

<%- include('partials/footer') %>
