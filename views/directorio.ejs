<%- include('partials/header', { descripcion: 'Directorio de comercios del Gran Mendoza: buscá por rubro, zona o nombre.' }) %>

<hgroup class="encabezado">
  <h1>Directorio de comercios</h1>
  <p>Encontrá comercios, profesionales y oficios del Gran Mendoza.</p>
</hgroup>

<form method="get" action="/directorio" role="search" class="buscador" aria-label="Buscar comercios">
  <div class="grid">
    <div>
      <label for="q">Buscar</label>
      <input type="search" id="q" name="q" value="<%= filtros.q %>" placeholder="Por ejemplo: pizza, contador, vino" maxlength="80">
    </div>
    <div>
      <label for="rubro">Rubro</label>
      <select id="rubro" name="rubro">
        <option value="">Todos los rubros</option>
        <% cfg.RUBROS.forEach((r) => { %>
          <option value="<%= r.id %>" <%= filtros.rubro === r.id ? 'selected' : '' %>><%= r.nombre %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="zona">Zona</label>
      <select id="zona" name="zona">
        <option value="">Todas las zonas</option>
        <% cfg.ZONAS.forEach((z) => { %>
          <option value="<%= z.id %>" <%= filtros.zona === z.id ? 'selected' : '' %>><%= z.nombre %></option>
        <% }) %>
      </select>
    </div>
  </div>
  <div class="acciones">
    <button type="submit">Buscar</button>
    <% if (filtros.q || filtros.rubro || filtros.zona) { %><a href="/directorio" role="button" class="secondary outline">Limpiar filtros</a><% } %>
  </div>
</form>

<section aria-labelledby="titulo-resultados">
  <h2 id="titulo-resultados" class="resultados-titulo">
    <%= resultados.length === 1 ? '1 comercio encontrado' : `${resultados.length} comercios encontrados` %>
  </h2>
  <% if (!resultados.length) { %>
    <p>No encontramos comercios con esos filtros. Probá con otra palabra o elegí «Todas las zonas».</p>
  <% } else { %>
    <div class="grilla-comercios">
      <% resultados.forEach((c) => { %><%- include('partials/tarjeta-comercio', { c }) %><% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
